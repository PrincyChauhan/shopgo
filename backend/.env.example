DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres?sslmode=disable
JWT_SECRET=please-change-this-to-any-long-random-text
ADMIN_EMAIL=admin@shopgo.local
ADMIN_PASSWORD=admin12345
PORT=8080

# ---- Razorpay (optional). Leave empty to use the free DEMO payment. ----
# Test keys: Razorpay Dashboard -> switch to "Test Mode" -> Account & Settings -> API Keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Only needed for webhooks (Dashboard -> Webhooks). Optional for local testing.
RAZORPAY_WEBHOOK_SECRET=

# ---- AI (optional). Leave AI_API_KEY empty to disable AI features. ----
# Free Gemini key: https://aistudio.google.com/apikey
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_API_KEY=
AI_MODEL=gemini-2.5-flash

# To switch to Groq instead, replace the 3 lines above with:
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile
